  m_Script: {fileID: 11500000, guid: 8be3892d1932f536a979e14b023698e7, type: 3}
  m_Name: dialog_healer
  m_EditorClassIdentifier: Ashenveil.Runtime::Ashenveil.Dialog.DialogGraph
  _dialogId: dialog_healer
  _entryNodeId: start
  _nodes:
  - _id: start
    _speakerName: Heilerin
    _text: "Sei gegr\xFC\xDFt, Fremder. Der Wald ist krank... bringst du mir Blutmoos?"
    _choices:
    - _text: Ich helfe dir. (Auftrag annehmen)
      _targetNodeId: accept
      _questAction:
        _actionType: 1
        _questId: quest_herbs
      _condition:
        _enabled: 0
        _questId: quest_id
        _requiredState: 1
    - _text: "Vielleicht sp\xE4ter."
      _targetNodeId: end
      _questAction:
        _actionType: 0
        _questId: quest_id
      _condition:
        _enabled: 0
        _questId: quest_id
        _requiredState: 1
  - _id: accept
    _speakerName: Heilerin
    _text: "Hab Dank. F\xFCnf B\xFCschel gen\xFCgen."
    _choices: []
  - _id: end
    _speakerName: Heilerin
    _text: "Der \xC4ther wartet nicht."
    _choices: []
