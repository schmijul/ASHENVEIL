  m_Script: {fileID: 11500000, guid: 8be3892d1932f536a979e14b023698e7, type: 3}
  m_Name: dialog_smith
  m_EditorClassIdentifier: Ashenveil.Runtime::Ashenveil.Dialog.DialogGraph
  _dialogId: dialog_smith
  _entryNodeId: start
  _nodes:
  - _id: start
    _speakerName: Schmied
    _text: Verflucht! Mein Hammer liegt irgendwo am Fluss. Findest du ihn?
    _choices:
    - _text: Ich suche ihn. (Auftrag annehmen)
      _targetNodeId: accept
      _questAction:
        _actionType: 1
        _questId: quest_tool
      _condition:
        _enabled: 0
        _questId: quest_id
        _requiredState: 1
    - _text: Keine Zeit.
      _targetNodeId: end
      _questAction:
        _actionType: 0
        _questId: quest_id
      _condition:
        _enabled: 0
        _questId: quest_id
        _requiredState: 1
  - _id: accept
    _speakerName: Schmied
    _text: Am Ufer, bei den Felsen. Danke dir!
    _choices: []
  - _id: end
    _speakerName: Schmied
    _text: Dann eben nicht.
    _choices: []
